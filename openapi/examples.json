      "get": {
        "summary": "List render jobs",
        "operationId": "listRenders",
        "tags": ["renders"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          {
            "name": "template_id",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Paginated job list." }
        }
      }
