    "/v1/renders/{job_id}": {
      "get": {
        "summary": "Get render status",
        "operationId": "getRender",
        "tags": ["renders"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status.",
            "content": {
              "application/json": {
                "example": {
                  "job_id": "3f2a9c1b-4e8d-4b5a-bc3c-9f1e2d3a4567",
                  "template_id": "sales_personalization",
                  "template_version": "v1",
                  "status": "completed",
                  "progress": 100,
                  "output_url": "https://cdn.example.com/artifacts/sales_personalization/3f2a9c1b.mp4?token=xxx",
                  "error_code": null,
                  "error_message": null,
                  "retry_count": 0,
                  "playlist_name": "Launch Week Playlist",
                  "playlist_actions": [
                    {
                      "action_id": "d89b6d54-2a38-4a25-b3b7-6b725e430a99",
                      "action": "download",
                      "playlist_name": "Launch Week Playlist",
                      "destination": "ios-device-teefi",
                      "status": "queued",
                      "created_at": "2026-05-04T08:03:00Z"
                    }
                  ],
                  "created_at": "2026-05-04T08:00:00Z",
                  "updated_at": "2026-05-04T08:02:18Z"
                }
              }
            }
          },
          "404": { "description": "Job not found." }
        }
      },
      "delete": {
        "summary": "Cancel a queued job",
        "operationId": "cancelRender",
        "tags": ["renders"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Job canceled." },
          "409": { "description": "Job cannot be canceled in current state." }
        }
      }
    },
    "/v1/renders/{job_id}/playlist": {
      "post": {
        "summary": "Queue a post-completion playlist action",
        "operationId": "queuePlaylistAction",
        "tags": ["renders"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "listen": {
                  "summary": "Queue listen action",
                  "value": {
                    "action": "listen",
                    "playlist_name": "Audio Queue",
                    "destination": "podcast-app"
                  }
                },
                "export": {
                  "summary": "Queue export action",
                  "value": {
                    "action": "export",
                    "playlist_name": "Partner Delivery",
                    "destination": "s3://media-exports/partner-drop"
                  }
                },
                "download": {
                  "summary": "Queue download action",
                  "value": {
                    "action": "download",
                    "playlist_name": "My Downloads",
                    "destination": "macbook-pro"
                  }
                },
                "share": {
                  "summary": "Queue share action",
                  "value": {
                    "action": "share",
                    "playlist_name": "Social Push",
                    "destination": "youtube-channel-main"
                  }
                },
                "deploy": {
                  "summary": "Queue deploy action",
                  "value": {
                    "action": "deploy",
                    "playlist_name": "Living Room Screens",
                    "destination": "roku-living-room"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Playlist action queued.",
            "content": {
              "application/json": {
                "example": {
                  "job_id": "3f2a9c1b-4e8d-4b5a-bc3c-9f1e2d3a4567",
                  "status": "completed",
                  "output_url": "https://cdn.example.com/artifacts/sales_personalization/3f2a9c1b.mp4?token=xxx",
                  "playlist_name": "Living Room Screens",
                  "actions": [
                    {
                      "action_id": "1e4ac84f-80be-4b0a-9455-1b42de9ce040",
                      "action": "deploy",
                      "playlist_name": "Living Room Screens",
                      "destination": "roku-living-room",
                      "status": "queued",
                      "created_at": "2026-05-04T08:03:00Z"
                    }
                  ]
                }
              }
            }
          },
          "404": { "description": "Job not found." },
          "409": {
            "description": "Job must be completed with output before queueing playlist actions."
          }
        }
      },
      "get": {
        "summary": "Get post-completion playlist actions",
        "operationId": "getPlaylistActions",
        "tags": ["renders"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Playlist actions for a render job.",
            "content": {
              "application/json": {
                "example": {
                  "job_id": "3f2a9c1b-4e8d-4b5a-bc3c-9f1e2d3a4567",
                  "status": "completed",
                  "output_url": "https://cdn.example.com/artifacts/sales_personalization/3f2a9c1b.mp4?token=xxx",
                  "playlist_name": "Social Push",
                  "actions": [
                    {
                      "action_id": "8de0bcee-a767-41d9-86f0-f294ac47f8f7",
                      "action": "share",
                      "playlist_name": "Social Push",
                      "destination": "youtube-channel-main",
                      "status": "queued",
                      "created_at": "2026-05-04T08:03:00Z"
                    }
                  ]
                }
              }
            }
          },
          "404": { "description": "Job not found." }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "tags": ["ops"],
