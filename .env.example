# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vop_user:vop_pass@localhost:5432/vop_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage backend: "local" | "s3" | "azure" ────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./artifacts

# S3 settings (required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Azure Blob settings (required when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# ── Renderer ──────────────────────────────────────────────────────────────────
RENDER_WORK_DIR=./tmp/renders
# Path to the node render script relative to WORKDIR
RENDER_SCRIPT_PATH=./render.js

# ── Worker retry policy ───────────────────────────────────────────────────────
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_MAX_TRIES=3
WORKER_RETRY_DELAY_SECONDS=15

# ── Signed URL expiry ─────────────────────────────────────────────────────────
SIGNED_URL_EXPIRES_SECONDS=86400

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
# REQUIRED for docker-compose — must match the value your API clients send in X-API-Key
API_KEY_SECRET=changeme-use-a-long-random-string-in-production
